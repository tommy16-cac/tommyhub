-- Auto Farm Theo Level
local plr = game.Players.LocalPlayer
repeat wait() until plr.Character
local chr = plr.Character
local hrp = chr:WaitForChild("HumanoidRootPart")

-- Tự bật haki
function enableHaki()
    local args = {
        [1] = "Buso"
    }
    game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer(unpack(args))
end

-- Danh sách quái theo level
local mobList = {
    {Level = 10, Name = "Bandit", Pos = CFrame.new(1036, 17, 1547)},
    {Level = 15, Name = "Monkey", Pos = CFrame.new(-1602, 36, 146)},
    {Level = 30, Name = "Pirate", Pos = CFrame.new(-1115, 14, 3938)},
    {Level = 60, Name = "Desert Bandit", Pos = CFrame.new(932, 7, 4486)},
    {Level = 90, Name = "Snow Bandit", Pos = CFrame.new(1345, 87, -1373)},
    -- Thêm quái khác nếu muốn
}

-- Hàm lấy quái phù hợp theo level
function getMobByLevel(lv)
    local mob = nil
    for i = #mobList, 1, -1 do
        if lv >= mobList[i].Level then
            mob = mobList[i]
            break
        end
    end
    return mob
end

-- Tìm quái trong workspace
function getEnemy(name)
    for _, v in pairs(game:GetService("Workspace").Enemies:GetChildren()) do
        if v.Name == name and v:FindFirstChild("HumanoidRootPart") and v.Humanoid.Health > 0 then
            return v
        end
    end
end

-- Bắt đầu Auto Farm
_G.AutoFarm = true
spawn(function()
    while _G.AutoFarm do
        pcall(function()
            enableHaki()

            local level = plr.Data.Level.Value
            local mobData = getMobByLevel(level)

            if mobData then
                local enemy = getEnemy(mobData.Name)
                if enemy then
                    repeat
                        if enemy.Humanoid.Health > 0 then
                            hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0) -- bay phía trên
                            wait(0.15)
                            -- Tấn công
                            game:GetService("VirtualInputManager"):SendKeyEvent(true, "Z", false, game)
                            game:GetService("VirtualInputManager"):SendKeyEvent(false, "Z", false, game)
                        end
                        wait()
                    until enemy.Humanoid.Health <= 0 or not _G.AutoFarm
                else
                    -- Teleport đến khu vực quái
                    hrp.CFrame = mobData.Pos + Vector3.new(0, 10, 0)
                    wait(1)
                end
            end
        end)
        wait()
    end
end)
