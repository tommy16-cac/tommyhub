-- Biến trạng thái
local autoFarmToken = false
local autoCollectBoxes = false
local autoUsePowerUp = false

-- Chức năng bật/tắt menu
ToggleButton.MouseButton1Click:Connect(function()
	MainFrame.Visible = not MainFrame.Visible
end)

-- Chức năng Auto Farm Token
AutoFarmTokenButton.MouseButton1Click:Connect(function()
	autoFarmToken = not autoFarmToken
	AutoFarmTokenButton.Text = "Auto Farm Token: " .. (autoFarmToken and "ON" or "OFF")
	
	while autoFarmToken do
		-- Thêm mã tự động farm token tại đây
		wait(1)
	end
end)

